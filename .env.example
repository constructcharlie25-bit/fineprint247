# Copy this file to .env for local development. NEVER commit real keys.
# On Vercel: Project -> Settings -> Environment Variables (set for Production,
# Preview, and Development), then Redeploy.

# --- LLM (required for live scans; without it the app runs in demo mode) ---
OPENAI_API_KEY=
# Legacy alias (still supported): LLM_API_KEY=
# Optional: any OpenAI-compatible chat-completions endpoint
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: model name (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# --- Stripe (payments stay stubbed until STRIPE_SECRET_KEY is set; see SETUP.md) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_MONTHLY=
STRIPE_WEBHOOK_SECRET=

# --- App ---
# Production URL (used for Stripe success/cancel redirects)
APP_URL=https://fineprint247.com
