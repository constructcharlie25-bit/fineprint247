# Copy this file to .env for local development. NEVER commit real keys.
# On Vercel: Project -> Settings -> Environment Variables (set for Production).

# --- LLM (required for live scans; without it the app runs in demo mode) ---
LLM_API_KEY=
# Optional: any OpenAI-compatible chat-completions endpoint
LLM_API_BASE_URL=https://api.openai.com/v1
# Optional: model name
LLM_MODEL=gpt-4o-mini

# --- Stripe (payments are stubbed until these are set; see SETUP.md) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_MONTHLY=
STRIPE_WEBHOOK_SECRET=

# --- App ---
# Production URL, e.g. https://fineprint.example.com (used for Stripe redirects)
APP_URL=http://localhost:3000
